# Скопируйте этот файл в .env.
# Значения используются только для предзаполнения формы подключения.

PGHOST=localhost
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=postgres

# Дополнительные настройки приложения (необязательно):
